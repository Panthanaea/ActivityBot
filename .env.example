# Copy this file to .env and fill in your values. Never commit the real .env file.

# Bot token from https://discord.com/developers/applications -> Your App -> Bot
DISCORD_TOKEN=

# Application (Client) ID from the "General Information" page of your application
CLIENT_ID=

# Optional: set this during development to register slash commands to a single
# guild instantly (propagates in seconds). Leave blank to register commands
# globally (can take up to ~1 hour to propagate to all servers).
GUILD_ID=

# Optional: cron expression overrides (see https://crontab.guru). Defaults shown.
# Daily inactivity sweep — default: every day at 03:00 UTC
SWEEP_CRON=0 3 * * *
# Monthly prune — default: 1st of the month at 04:00 UTC
PRUNE_CRON=0 4 1 * *

# How many days a member may hold the inactive role before being kicked in the
# monthly prune. Fixed at 90 per spec, but exposed here in case you want to tune it.
PRUNE_AFTER_DAYS=90
